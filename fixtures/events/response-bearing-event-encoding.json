{
  "suite": "events/response-bearing-event-encoding",
  "version": 1,
  "description": "A response-bearing event uses the captured UUIDv7 as the direct /i/event idempotency_key. The same canonical event can later retry through either the direct control lane or batch delivery without minting a shadow identity.",
  "vectors": [
    {
      "name": "journey transition direct request retains captured identity",
      "event": {
        "id": "019c0644-fc00-7000-8000-000000000001",
        "name": "$journey_transition",
        "distinct_id": "customer-response-1",
        "timestamp": "2026-08-28T12:00:00Z",
        "properties": {
          "journey_id": "journey-response-1",
          "epoch": 4,
          "value": 1,
          "entityId": "journey-response-1"
        }
      },
      "expect": {
        "event": "$journey_transition",
        "distinct_id": "customer-response-1",
        "idempotency_key": "019c0644-fc00-7000-8000-000000000001",
        "timestamp": "2026-08-28T12:00:00.000Z",
        "value": 1,
        "entity_id": "journey-response-1"
      },
      "expect_properties_json": "{\"entityId\":\"journey-response-1\",\"epoch\":4,\"journey_id\":\"journey-response-1\",\"value\":1}"
    }
  ]
}
