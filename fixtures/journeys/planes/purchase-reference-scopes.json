{
  "values": [
    {
      "viewModelName": "WelcomeModel",
      "instanceId": "welcome",
      "path": "product",
      "value": {
        "placementId": "golden:yearly"
      }
    },
    {
      "viewModelName": "WelcomeModel",
      "instanceId": "secondary",
      "path": "product",
      "value": {
        "placementId": "golden:secondary"
      }
    }
  ],
  "cases": [
    {
      "name": "changed root",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId"
        }
      },
      "expected": "golden:monthly"
    },
    {
      "name": "explicit root model",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId",
          "viewModelName": "WelcomeModel"
        }
      },
      "expected": "golden:monthly"
    },
    {
      "name": "secondary occurrence",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId"
        }
      },
      "instanceId": "secondary",
      "expected": "golden:secondary"
    },
    {
      "name": "missing model",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId",
          "viewModelName": "MissingModel"
        }
      },
      "expected": null
    },
    {
      "name": "explicit absolute ignores occurrence",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId",
          "isRelative": false
        }
      },
      "expected": "golden:monthly",
      "instanceId": "secondary"
    },
    {
      "name": "explicit relative uses occurrence",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId",
          "isRelative": true
        }
      },
      "expected": "golden:secondary",
      "instanceId": "secondary"
    },
    {
      "name": "explicit relative requires occurrence",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId",
          "isRelative": true
        }
      },
      "expected": null
    },
    {
      "name": "explicit absolute without occurrence",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId",
          "isRelative": false
        }
      },
      "expected": "golden:monthly"
    },
    {
      "name": "relative rejects detached occurrence",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId",
          "isRelative": true
        }
      },
      "instanceId": "retired",
      "expected": null
    },
    {
      "name": "relative rejects conflicting model",
      "reference": {
        "ref": {
          "kind": "path",
          "path": "product.placementId",
          "isRelative": true,
          "viewModelName": "OtherModel"
        }
      },
      "instanceId": "secondary",
      "expected": null
    }
  ]
}
