      "lineHeight": 12,
      "containScale": 1,
      "geometryScale": 1,
      "expectedFontSize": 16,
      "expectedBaselineDistance": 12
    },
    {
      "name": "natural-scaled",
      "fontSize": 16,
      "lineHeight": -1,
      "containScale": 1,
      "geometryScale": 1.5,
      "expectedFontSize": 24.0,
      "expectedBaselineDistance": null
    },
    {
      "name": "explicit-scaled",
      "fontSize": 16,
      "lineHeight": 32,
      "containScale": 1,
      "geometryScale": 1.5,
      "expectedFontSize": 24.0,
      "expectedBaselineDistance": 48.0
    },
    {
      "name": "natural-contained",
