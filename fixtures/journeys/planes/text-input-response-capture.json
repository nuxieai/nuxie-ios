    { "name": "secure binding captures normalized source not masked text", "mode": "binding", "text": "••••••", "secure": true, "source": "normalized", "expected": "normalized" },
    { "name": "secure empty source remains empty", "mode": "binding", "text": "secret", "secure": true, "source": "", "expected": "" },
