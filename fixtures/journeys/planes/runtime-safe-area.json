{
  "contract": "The insets are the view's own, in points (dp). Arrays are width,height or top,bottom,left,right. Pixel inputs are divided by scale once before publication.",
  "cases": [
    {
      "name": "phone",
      "view": [
        393,
        852
      ],
      "scale": 3,
      "pixelInsets": [
        177,
        102,
        0,
        0
      ],
      "expected": [
        59,
        34,
        0,
        0
      ]
    },
    {
      "name": "tablet",
      "view": [
        820,
        1180
      ],
      "scale": 2,
      "pixelInsets": [
        118,
        68,
        0,
        0
      ],
      "expected": [
        59,
        34,
        0,
        0
      ]
    },
    {
      "name": "fractional-density",
      "view": [
        400,
        800
      ],
      "scale": 2.625,
      "pixelInsets": [
        147,
        63,
        21,
        42
      ],
      "expected": [
        56,
        24,
        8,
        16
      ]
    },
    {
      "name": "landscape",
      "view": [
        852,
        393
      ],
      "scale": 3,
      "pixelInsets": [
        0,
        63,
        177,
        177
      ],
      "expected": [
        0,
        21,
        59,
        59
      ]
    },
    {
      "name": "zero",
      "view": [
        375,
        667
      ],
      "scale": 3,
      "pixelInsets": [
        0,
        0,
        0,
        0
      ],
      "expected": [
        0,
        0,
        0,
        0
      ]
    }
  ]
}
