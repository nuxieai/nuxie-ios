{
  "suite": "journeys/handler-host-dispatch/lifecycle",
  "version": 1,
  "description": "Every dispatch host must declare its event. Lifecycle events prefer a declared screen host, then use the declared global Journey host. Handler-only hosts are never dispatchable, matching the canonical TypeScript runtime and compiler handler_without_event warning.",
  "vectors": [
    {
      "name": "declared screen host receives screen shown",
      "event": "$screen_shown",
      "screenId": "screen-1",
      "screenDeclarations": ["$screen_shown"],
      "handlers": [
        {
          "host": "screen-1",
          "event": "$screen_shown",
          "marker": "screen_shown_via_screen"
        },
        {
          "host": "__journey__",
          "event": "$screen_shown",
          "marker": "screen_shown_via_journey"
        }
      ],
      "expectedMarkers": ["screen_shown_via_screen"]
    },
    {
      "name": "declared screen host receives screen dismissed",
      "event": "$screen_dismissed",
      "screenId": "screen-1",
      "screenDeclarations": ["$screen_dismissed"],
      "handlers": [
        {
          "host": "screen-1",
          "event": "$screen_dismissed",
          "marker": "screen_dismissed_via_screen"
        },
        {
          "host": "__journey__",
          "event": "$screen_dismissed",
          "marker": "screen_dismissed_via_journey"
        }
      ],
      "expectedMarkers": ["screen_dismissed_via_screen"]
    },
    {
      "name": "screen shown falls back to global Journey host",
      "event": "$screen_shown",
      "screenId": "screen-1",
      "screenDeclarations": [],
      "journeyDeclarations": ["$screen_shown"],
      "handlers": [
        {
          "host": "screen-1",
          "event": "$screen_shown",
          "marker": "undeclared_screen_shown"
        },
        {
          "host": "__journey__",
          "event": "$screen_shown",
          "marker": "journey_shown"
        }
      ],
      "expectedMarkers": ["journey_shown"]
    },
    {
      "name": "screen dismissed falls back to global Journey host",
      "event": "$screen_dismissed",
      "screenId": "screen-1",
      "screenDeclarations": [],
      "journeyDeclarations": ["$screen_dismissed"],
      "handlers": [
        {
          "host": "screen-1",
          "event": "$screen_dismissed",
          "marker": "undeclared_screen_dismissed"
        },
        {
          "host": "__journey__",
          "event": "$screen_dismissed",
          "marker": "journey_dismissed"
        }
      ],
      "expectedMarkers": ["journey_dismissed"]
    },
    {
      "name": "handler-only screen lifecycle host is dropped without journey fallback",
      "event": "$screen_shown",
      "screenId": "screen-1",
      "screenDeclarations": [],
      "handlers": [
        {
          "host": "screen-1",
          "event": "$screen_shown",
          "marker": "undeclared_screen_only"
        }
      ],
      "expectedMarkers": []
    },
    {
      "name": "handler-only journey lifecycle host is dropped",
      "event": "$screen_shown",
      "screenId": "screen-1",
      "screenDeclarations": [],
      "journeyDeclarations": [],
      "handlers": [
        {
          "host": "__journey__",
          "event": "$screen_shown",
          "marker": "undeclared_journey_lifecycle"
        }
      ],
      "expectedMarkers": []
    },
    {
      "name": "handler-only screen host is strict for ordinary events",
      "event": "continue_tapped",
      "screenId": "screen-1",
      "screenDeclarations": [],
      "handlers": [
        {
          "host": "screen-1",
          "event": "continue_tapped",
          "marker": "undeclared_ordinary_event"
        }
      ],
      "expectedMarkers": []
    },
    {
      "name": "declared journey host receives ordinary events",
      "event": "server_signal",
      "dispatch": "journey",
      "screenId": "screen-1",
      "screenDeclarations": [],
      "journeyDeclarations": ["server_signal"],
      "handlers": [
        {
          "host": "__journey__",
          "event": "server_signal",
          "marker": "declared_journey_event"
        }
      ],
      "expectedMarkers": ["declared_journey_event"]
    },
    {
      "name": "handler-only journey host is strict for ordinary events",
      "event": "server_signal",
      "dispatch": "journey",
      "screenId": "screen-1",
      "screenDeclarations": [],
      "journeyDeclarations": [],
      "handlers": [
        {
          "host": "__journey__",
          "event": "server_signal",
          "marker": "undeclared_journey_event"
        }
      ],
      "expectedMarkers": []
    }
  ]
}
