{
  "suite": "purchases/test-store-configuration",
  "version": 1,
  "platform": "android",
  "notes": [
    "A pk_test_ key selects test content on any service, so admission needs a test key and a debuggable host; the service environment plays no part. iOS refuses a non-debug build the same way.",
    "This contract checks runtime setup admission, not a Gradle build-time detector."
  ],
  "cases": [
    {
      "name": "default-service-test-debug",
      "enabled": true,
      "environment": "PRODUCTION",
      "apiKey": "pk_test_fixture",
      "debuggable": true,
      "allowed": true
    },
    {
      "name": "development-test-debug",
      "enabled": true,
      "environment": "DEVELOPMENT",
      "apiKey": "pk_test_fixture",
      "debuggable": true,
      "allowed": true
    },
    {
      "name": "live-key",
      "enabled": true,
      "environment": "PRODUCTION",
      "apiKey": "pk_live_fixture",
      "debuggable": true,
      "allowed": false
    },
    {
      "name": "non-debuggable-host",
      "enabled": true,
      "environment": "PRODUCTION",
      "apiKey": "pk_test_fixture",
      "debuggable": false,
      "allowed": false
    },
    {
      "name": "disabled-production",
      "enabled": false,
      "environment": "PRODUCTION",
      "apiKey": "pk_live_fixture",
      "debuggable": false,
      "allowed": true
    }
  ]
}
