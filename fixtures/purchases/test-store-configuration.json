    {
      "name": "production-environment",
      "enabled": true,
      "environment": "PRODUCTION",
      "apiKey": "pk_test_fixture",
      "debuggable": true,
      "allowed": false
    },
    {
      "name": "live-key",
      "enabled": true,
      "environment": "DEVELOPMENT",
      "apiKey": "pk_live_fixture",
      "debuggable": true,
      "allowed": false
    },
    {
      "name": "non-debuggable-host",
      "enabled": true,
      "environment": "DEVELOPMENT",
      "apiKey": "pk_test_fixture",
      "debuggable": false,
      "allowed": false
    },
    {
      "name": "disabled-production",
      "enabled": false,
      "environment": "PRODUCTION",
      "apiKey": "pk_live_fixture",
      "debuggable": false,
      "allowed": true
