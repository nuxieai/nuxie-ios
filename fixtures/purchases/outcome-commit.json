        "uniqueEvidenceRows": 1,
        "journeyAdvancements": 1,
        "purchaseCompletedEvents": 1,
        "restoreCompletedEvents": 0,
        "purchaseFailedEvents": 0,
        "serverSyncRequests": 1,
        "scheduledSyncTasks": 1,
        "pendingRecords": 0,
        "overlayEverPresent": true,
        "storeEntitlementQueries": 1,
        "checkoutErrors": [
          "pending"
        ],
        "committerTerminalOutcomes": [
          {
            "kind": "pending",
            "source": "checkout",
            "terminal": true
          }
        ],
        "completionSources": [
          "deferred_update"
        ],
        "completionCarriesEvidenceIdentity": true,
        "completionCarriesProductMapping": true
      }
    },
