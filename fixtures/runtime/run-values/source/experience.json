{
  "$schema": "https://nuxie.ai/schema/experience/1.json",
  "platforms": ["ios:apple_app_store"],
  "entry": {
    "steps": [
      {
        "type": "navigate",
        "screen": "screens/tap"
      }
    ],
    "trigger": {
      "type": "event",
      "eventName": "$app_opened"
    },
    "frequency": {
      "type": "every_match"
    }
  },
  "state": {
    "trip_days": {
      "type": "number",
      "default": 23
    },
    "level": {
      "type": "number",
      "default": 1
    }
  },
  "journey": [
    {
      "screen": "screens/tap",
      "on": "continue",
      "steps": [
        {
          "type": "navigate",
          "screen": "screens/level"
        }
      ]
    },
    {
      "screen": "screens/level",
      "on": "continue",
      "steps": [
        {
          "type": "navigate",
          "screen": "screens/device"
        }
      ]
    }
  ]
}
