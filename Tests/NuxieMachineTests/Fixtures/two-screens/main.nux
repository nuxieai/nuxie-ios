use Card from "card"

component Stack
  platforms ios android

  state taps = 0

  entry
    on event "opened"
    do open

  routes
    first   Card(title="First", taps=taps, bump=bump, next=deeper, previous=leave, swap=swap, blink=blink, flash=flash, close=close)  cover
    second  Card(title="Second", taps=taps, bump=bump, next=deeper, previous=leave, swap=swap, blink=blink, flash=flash, close=close)  sheet

  action open
    go(first)

  action deeper
    go(second)

  action leave
    back

  action bump
    taps = taps + 1

  action swap
    go(second, replace)

  action blink
    go(second)
    back

  action flash
    go(second)
    dismiss("flashed")

  action close
    dismiss("closed")
    exit
