use Counter from "counter"

component Tally
  platforms ios android

  entry
    on event "opened"
    do open

  routes
    counter  Counter(close=close)  cover

  action open
    go(counter)

  action close
    dismiss("closed")
    exit

  test "the counter opens and its buttons keep it open"
    event "opened"
    expect route counter
    tap "bump"
    expect route counter
    tap "bump"
    tap "hide"
    expect route counter

  test "closing the counter ends the Journey"
    event "opened"
    tap "close"
    expect route none
    expect ended
