use Home, Plans, Frozen from "sheets"

routes nav
  home "/home"
  plans "/plans"
  frozen "/frozen"

component Sheets
  platforms ios android

  state closable = false
  state locked = false
  state closes = 0

  entry covered
    on event "onboarding_completed"
    do open

  entry offered
    on event "offered"
    do offer

  action open
    nav = push(nav, path("home"))

  action offer
    nav = push(nav, path("plans"))

  action freeze
    nav = push(nav, path("frozen"))

  action allow
    closable = true

  action lock
    locked = true

  action close
    closes = closes + 1
    if depth(nav) > 1
      nav = back(nav)
    else
      nav = clear(nav)
      exit

  view
    column
      for e in stack(nav) key=e.id
        match e.name
          case home
            Home(offer=offer, freeze=freeze)  presentation=cover
          case plans
            Plans(closable=closable, locked=locked, allow=allow, lock=lock, close=close)  presentation=sheet detent="medium 40% 320" swipe="close"
          case frozen
            Frozen(close=close)  presentation=sheet swipe=none
