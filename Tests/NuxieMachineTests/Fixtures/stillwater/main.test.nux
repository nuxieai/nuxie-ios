test "the offer waits for her to come back"
  given customer.plan = "free"
  clock to 09:00
  event "onboarding_completed"
  expect text "title" == "Ten quiet minutes,\nevery day."
  tap "close"
  app closes
  clock to 18:00
  expect route none
  expect held server
  clock to 20:00
  app opens
  expect route offer
  expect text "buy" == "Claim the offer"

test "an offer nobody came back for is given up"
  given customer.plan = "free"
  clock to 09:00
  event "onboarding_completed"
  tap "close"
  app closes
  clock +2d
  app opens
  expect route none
  expect ended

test "she already paid on her tablet"
  given customer.plan = "free"
  given owns[annual] = true
  event "onboarding_completed"
  expect route thanks
  expect text "close" == "Done"

test "she buys the plan chosen when the paywall opens"
  given customer.plan = "free"
  event "onboarding_completed"
  expect sent exposed name="headline"
  expect state plan == annual
  tap "buy"
  expect called purchase product=catalog[annual]
  purchase answers status=completed
  expect route done
  expect missing "buy"
  expect not called restore

test "a purchase that does not go through says so"
  given customer.plan = "free"
  event "onboarding_completed"
  expect missing "error"
  tap "buy"
  purchase answers status=failed
  expect state purchase_failed == true
  expect has "error"
  expect route paywall

test "a busy buy button takes no press"
  given customer.plan = "free"
  event "onboarding_completed"
  tap "buy"
  expect called purchase product=catalog[annual]
  tap "buy"
  expect not called purchase

test "the trial's terms open and close"
  given customer.plan = "free"
  event "onboarding_completed"
  expect missing "terms"
  tap "details"
  expect has "terms"
  tap "details"
  expect missing "terms"

test "the evening offer joins the plans while she looks"
  given customer.plan = "free"
  clock to 17:00
  event "onboarding_completed"
  expect text "buy" == "Continue"
  clock to 18:00
  expect state offer_live == true
  expect state plan == annual_offer
  expect text "buy" == "Claim the offer"
  tap "buy"
  expect called purchase product=catalog[annual_offer]

test "the evening offer leaves when it ends"
  given customer.plan = "free"
  clock to 17:00
  event "onboarding_completed"
  clock to 18:00
  clock to 20:00
  expect state offer_live == false
  expect state plan == annual
  expect text "buy" == "Continue"
  expect route paywall

test "an offer missed while she was away is skipped"
  given customer.plan = "free"
  clock to 17:00
  event "onboarding_completed"
  app closes
  clock to 21:00
  app opens
  expect state offer_live == false
  expect state plan == annual
  expect text "buy" == "Continue"
  expect route paywall

test "an offer she comes back to in time leaves at 20:00"
  given customer.plan = "free"
  clock to 17:00
  event "onboarding_completed"
  app closes
  clock to 19:30
  app opens
  expect state offer_live == true
  expect state plan == annual_offer
  clock to 20:00
  expect state offer_live == false
  expect state plan == annual
  expect text "buy" == "Continue"

test "a paywall first opened after 18:00 has no offer tonight"
  given customer.plan = "free"
  clock to 19:00
  event "onboarding_completed"
  clock to 20:00
  expect state offer_ahead == false
  expect state offer_live == false
  expect text "buy" == "Continue"
  expect route paywall
