use products, purchase, restore, store, owns, Purchase, PurchaseStatus from "nuxie/store"
use customer, access, count, event from "nuxie/person"
use assigned, exposed from "nuxie/experiments"
use Paywall, Plan, Choice from "paywall"
use Offer, Thanks from "screens"
use Done from "done"

component Stillwater
  platforms ios android

  enum Headline calm sleep

  derive catalog = products(Plan,
    annual       = store(ios="stillwater.pro.yearly",       android="pro:yearly"),
    monthly      = store(ios="stillwater.pro.monthly",      android="pro:monthly"),
    annual_offer = store(ios="stillwater.pro.yearly.offer", android="pro:yearly-offer"))

  state plan = annual
  state offer_due = false
  state ready = false
  state offer_ahead = false
  state offer_live = false
  state purchase_failed = false

  mutation bought: Purchase  then purchased

  derive headline = assigned("headline", Headline, fallback=calm)
  derive headline_text =
    match headline
      calm -> "Ten quiet minutes,\nevery day."
      sleep -> "Fall asleep\nin ten minutes."

  derive yearly = Choice(plan=annual, name="Yearly", product=catalog[annual])
  derive monthly_choice = Choice(plan=monthly, name="Monthly", product=catalog[monthly])
  derive offer_choice = Choice(plan=annual_offer, name="Tonight only", product=catalog[annual_offer])
  derive offered = (if offer_live then [offer_choice, yearly, monthly_choice] else [yearly, monthly_choice])

  entry
    on event "onboarding_completed"
    if customer.plan == "free" and not (access.pro ?? false)
    once
    goal count("$purchase_completed") >= 1 within 14d after shown
    do start

  routes
    paywall  Paywall sheet
      headline=headline_text
      plans=offered
      selected=plan
      busy=pending(bought)
      failed=purchase_failed
      select=choose
      buy=buy
      restore=restore_purchases
      close=close
    offer    Offer(product=catalog[annual_offer], busy=pending(bought), buy=buy_offer, close=decline)  sheet
    thanks   Thanks(close=finish)  sheet
    done     Done(close=finish)

  action start
    if owns[annual] or owns[monthly]
      go(thanks)
    else
      exposed("headline")
      offer_ahead = true
      go(paywall)

  action choose(picked: Plan)
    plan = picked

  action buy
    purchase_failed = false
    send bought = purchase(catalog[plan])

  action buy_offer
    send bought = purchase(catalog[annual_offer])

  action restore_purchases
    send bought = restore()

  action purchased
    if bought != none
      if bought.status == completed
        offer_ahead = false
        offer_live = false
        go(done, replace)
      else if bought.status == failed
        purchase_failed = true

  action close
    offer_ahead = false
    offer_live = false
    offer_due = true
    dismiss("paywall_closed")

  task offer_missed  when offer_ahead
    after(next 20:00, skip_offer)

  task offer_starts  when offer_ahead
    after(next 18:00, begin_offer)

  action skip_offer
    offer_ahead = false

  action begin_offer
    offer_ahead = false
    offer_live = true
    if plan == annual
      plan = annual_offer

  task offer_ends  when offer_live
    after(next 20:00, end_offer)

  action end_offer
    offer_live = false
    if plan == annual_offer
      plan = annual

  task offer_time  when offer_due
    after(next 18:00, offer_ready)

  task evening_offer  when ready and here
    change(show_offer)

  task offer_lapses  when ready and not here
    after(6h, give_up)

  action offer_ready
    offer_due = false
    ready = true

  action show_offer
    ready = false
    go(offer)

  action give_up
    ready = false
    exit

  action decline
    dismiss("offer_declined")
    exit

  action finish
    dismiss("purchased")
    exit
