style Card
  height=4.24rem padding="0 20" gap=14 flex-direction=row align-items=center
  background-color=panel border-radius=18 border-width=1 border-color=edge
  :checked
    border-width=2 border-color=mint

style Radio
  width=22 height=22 border-radius=11 border-width=1.5 border-color=radio
  align-items=center justify-content=center

style CardText
  color=ink font-size=1rem font-weight=600 line-height=1.29rem

component PlanCard
  props
    name: string
    price: string
    on: boolean
    press: action

  view
    button role=radio checked=on class=Card press=press
      box class=Radio
        if on
          box width=12 height=12 border-radius=6 background-color=mint
      text name class=CardText flex=1
      text price class=CardText text-align=right id="price"
