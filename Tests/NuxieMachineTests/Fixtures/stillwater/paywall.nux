use Product from "nuxie/store"
use PlanCard from "plan-card"

enum Plan annual monthly annual_offer

theme
  night = light-dark(#f6f8f7, #0d1214)
  panel = light-dark(#ffffff, #151c1f)
  edge = light-dark(#dde4e1, #232c30)
  mint = light-dark(#2f7d63, #9fcdb9)
  mint_off = light-dark(#a9c4b9, #4f665e)
  ring = light-dark(#a9c6ba, #4f6b61)
  radio = light-dark(#9aa7a3, #5d6a67)
  ink = light-dark(#16211d, #eef3f1)
  soft = light-dark(#3c4a46, #c9d3d0)
  quiet = light-dark(#5f6c68, #8a9794)
  faint = light-dark(#7d8986, #6c7875)
  alarm = light-dark(#b4472e, #f0a28e)

style Mark
  width=40 height=40 border-radius=20 border-width=1.5 border-color=ring
  align-items=center justify-content=center

style Title
  margin-top=28 color=ink font-size=32 font-weight=700 line-height=38 letter-spacing=-0.4

style Buy
  height=56 margin-top=28 border-radius=28 background-color=mint
  align-items=center justify-content=center
  :disabled
    background-color=mint_off

style BuyLabel
  color=night font-size=17 font-weight=700 line-height=24

style Note
  font-size=14 line-height=20 text-align=center

style Link
  flex=1 height=44 align-items=center justify-content=center

style LinkLabel
  color=quiet font-size=14 font-weight=500 line-height=20

component Paywall
  props
    headline: string
    plans: Product[]
    selected: Plan
    busy: boolean
    failed: boolean
    select: action(Plan)
    buy: action
    restore: action
    close: action

  state details_open = false

  action toggle_details
    details_open = not details_open

  view
    column width=100% height=100% padding="calc(env(safe-area-inset-top) + 64) 24 calc(env(safe-area-inset-bottom) + 34)" justify-content=space-between background-color=night id="page"
      column
        box class=Mark
          box width=12 height=12 border-radius=6 background-color=mint
        text headline class=Title id="title"
        column role=radiogroup label="Plan" gap=12 margin-top=40
          PlanCard(name="Yearly", price=(plans[0]?.price ?? ""), on=(selected == annual), press=select(annual)) id="annual"
          PlanCard(name="Monthly", price=(plans[1]?.price ?? ""), on=(selected == monthly), press=select(monthly)) id="monthly"
        button class=Buy disabled=busy press=buy id="buy"
          text (if selected == annual_offer then "Claim the offer" else "Continue") class=BuyLabel
        box height=52 padding-top=12
          if failed
            text "The purchase did not go through. Try again in a moment." class=Note color=alarm id="error"
      column id="footer"
        button height=48 align-items=center justify-content=center press=close id="close"
          text "Not now" color=soft font-size=16 font-weight=600 line-height=22
        row gap=12 margin-top=4
          button class=Link press=restore id="restore"
            text "Restore purchases" class=LinkLabel
          button class=Link press=toggle_details id="details"
            text "About the trial" class=LinkLabel
        box height=40 margin-top=8
          if details_open
            text "Billed through the store after the trial. Cancel any time." class=Note color=faint font-size=13 id="terms"
