use Product from "nuxie/store"
use PlanCard from "plan-card"

enum Plan annual monthly annual_offer

shape Choice
  plan: Plan
  name: string
  product: Product

theme
  night = light-dark(#f6f8f7, #0d1214)
  panel = light-dark(#ffffff, #151c1f)
  edge = light-dark(#dde4e1, #232c30)
  mint = light-dark(#2f7d63, #9fcdb9)
  mint_off = light-dark(#a9c4b9, #4f665e)
  ring = light-dark(#a9c6ba, #4f6b61)
  radio = light-dark(#9aa7a3, #5d6a67)
  ink = light-dark(#16211d, #eef3f1)
  soft = light-dark(#3c4a46, #c9d3d0)
  quiet = light-dark(#5f6c68, #8a9794)
  faint = light-dark(#7d8986, #6c7875)
  alarm = light-dark(#b4472e, #f0a28e)

style Mark
  width=40 height=40 border-radius=20 border-width=1.5 border-color=ring
  align-items=center justify-content=center

style Title
  margin-top=28 color=ink font-size=1.88rem font-weight=700 line-height=2.24rem letter-spacing=-0.4

style Buy
  height=3.29rem margin-top=28 border-radius=1.65rem background-color=mint
  align-items=center justify-content=center
  :disabled
    background-color=mint_off

style BuyLabel
  color=night font-size=1rem font-weight=700 line-height=1.41rem

style Note
  font-size=0.82rem line-height=1.18rem text-align=center

style Link
  flex=1 height=2.59rem min-height=44 align-items=center justify-content=center

style LinkLabel
  color=quiet font-size=0.82rem font-weight=500 line-height=1.18rem

component Paywall
  props
    headline: string
    plans: Choice[]
    selected: Plan
    busy: boolean
    failed: boolean
    select: action(Plan)
    buy: action
    restore: action
    close: action

  state details_open = false

  action toggle_details
    details_open = not details_open

  view
    column width=100% height=100% background-color=night
      scroll max-height=40% id="header"
        column padding="calc(env(safe-area-inset-top) + 64) calc(env(safe-area-inset-right) + 24) 0 calc(env(safe-area-inset-left) + 24)"
          box class=Mark
            box width=12 height=12 border-radius=6 background-color=mint
          text headline class=Title id="title"
      scroll flex=1 id="page"
        column min-height=100% padding="40 calc(env(safe-area-inset-right) + 24) calc(env(safe-area-inset-bottom) + 34) calc(env(safe-area-inset-left) + 24)" justify-content=space-between
          column
            column role=radiogroup label="Plan" gap=12
              for choice in plans key=choice.plan
                PlanCard(name=choice.name, price=choice.product.price, on=(selected == choice.plan), press=select(choice.plan))
            button class=Buy disabled=busy press=buy id="buy"
              text (if selected == annual_offer then "Claim the offer" else "Continue") class=BuyLabel
            box height=calc(2.36rem + 12) padding-top=12
              if failed
                text "The purchase did not go through. Try again in a moment." class=Note color=alarm id="error"
          column id="footer"
            button height=2.82rem min-height=44 align-items=center justify-content=center press=close id="close"
              text "Not now" color=soft font-size=0.94rem font-weight=600 line-height=1.29rem
            row gap=12 margin-top=4
              button class=Link press=restore id="restore"
                text "Restore purchases" class=LinkLabel
              button class=Link press=toggle_details id="details"
                text "About the trial" class=LinkLabel
            box height=2.36rem margin-top=8
              if details_open
                text "Billed through the store after the trial. Cancel any time." class=Note color=faint font-size=0.76rem id="terms"
