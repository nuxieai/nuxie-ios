use Product from "nuxie/store"

enum Plan annual monthly annual_offer

component Paywall
  props
    headline: string
    plans: Product[]
    selected: Plan
    busy: boolean
    failed: boolean
    select: action(Plan)
    buy: action
    restore: action
    close: action

  state details_open = false

  action toggle_details
    details_open = not details_open

  view
    column
      text headline id="title"
      button id="annual" selected=(selected == annual) price=(plans[0]?.price ?? "") press=select(annual)
        text "Yearly"
      button id="monthly" selected=(selected == monthly) price=(plans[1]?.price ?? "") press=select(monthly)
        text "Monthly"
      button id="buy" busy=busy press=buy
        label=(if selected == annual_offer then "Claim the offer" else "Continue")
      text "The purchase did not go through. Try again in a moment." id="error" visible=failed
      button id="close" press=close
        text "Not now"
      button id="restore" press=restore
        text "Restore purchases"
      button id="details" press=toggle_details
        text "About the trial"
      text "Billed through the store after the trial. Cancel any time." id="terms" visible=details_open
